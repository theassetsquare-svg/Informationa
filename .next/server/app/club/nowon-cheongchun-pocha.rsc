dren":"Q&A"}],[["$","div","0",{"className":"faq-item","children":[["$","p",null,{"className":"faq-q","children":["Q. ","여기은 일반 여기과 어떤 점이 다른가요?"]}],["$","p",null,{"className":"faq-a","children":"사운드 퀄리티와 인테리어에 집중한 상위 이곳입니다. 상업 EDM 드롭 대신 딥하우스·프로그레시브 중심의 성숙한 선곡이 특징입니다."}]]}],["$","div","1",{"className":"faq-item","children":[["$","p",null,{"className":"faq-q","children":["Q. ","운동화를 신고 가도 되나요?"]}],["$","p",null,{"className":"faq-a","children":"스마트캐주얼 이상을 요구합니다. 반바지, 슬리퍼, 후드티는 입장 거절 사유가 됩니다. 깔끔한 셔츠와 긴바지 조합을 추천합니다."}]]}],["$","div","2",{"className":"faq-item","children":[["$","p",null,{"className":"faq-q","children":["Q. ","어느 동네 분위기인가요?"]}],["$","p",null,{"className":"faq-a","children":" 해운대구 일대에 위치하며 해운대역 도보 15분 거리입니다. 택시로는 5분 내외이며 주변 유료주차장 이용도 가능합니다."}]]}],["$","div","3",{"className":"faq-item","children":[["$","p",null,{"className":"faq-q","children":["Q. ","VIP 구역과 일반석 차이가 큰가요?"]}],["$","p",null,{"className":"faq-a","children":"공식 인스타그램 또는 카카오톡 채널을 통해 최소 2~3일 전 예약합니다. 병 세트와 함께 테이블이 배정됩니다."}]]}],["$","div","4",{"className":"faq-item","children":[["$","p",null,{"className":"faq-q","children":["Q. ","해외 DJ 손님 공연은 자주 있나요?"]}],["$","p",null,{"className":"faq-a","children":"월 1~2회 글로벌 아티스트 초청 이벤트가 진행됩니다. 유럽·동남아 출신 DJ가 주로 참여하며 SNS에서 사전 공지합니다."}]]}],["$","div","5",{"className":"faq-item","children":[["$","p",null,{"className":"faq-q","children":["Q. ","음향 시스템에 대해 자세히 알고 싶습니다."]}],["$","p",null,{"className":"faq-a","children":"독일제 스피커와 맞춤형 앰프를 사용하며, 볼륨보다 중·저음 해상도에 초점을 맞춘 세팅입니다."}]]}],["$","div","6",{"className":"faq-item","children":[["$","p",null,{"className":"faq-q","children":["Q. ","솔로 방문 팁이 있나요?"]}],["$","p",null,{"className":"faq-a","children":"상위 공간 특성상 라운지 구역에서 혼자 음료를 마시며 음악을 감상하기에 적합한 환경입니다."}]]}],["$","div","7",{"className":"faq-item","children":[["$","p",null,{"className":"faq-q","children":["Q. ","주변에 숙소가 많나요?"]}],["$","p",null,{"className":"faq-a","children":"해운대 일대에 호텔과 게스트하우스가 밀집해 있어 도보 거리 내 숙소 선택지가 풍부합니다."}]]}],["$","div","8",{"className":"faq-item","children