---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroBlock from '../components/IntroBlock.astro';
import FAQ from '../components/FAQ.astro';
import Gallery from '../components/Gallery.astro';
import TrustBlock from '../components/TrustBlock.astro';

const title = "인덕원국빈관나이트 — 경기 남부 직장인이 퇴근 후 모이는 곳";
const description = "인덕원역 도보권, 고정 방문객이 많아 분위기가 안정적이다. 테이블 배치·합석 매너·이성 비율 높은 시간대까지 첫 방문 실전 정리.";
const ogImage = "/q/og-thumb.png";
const storeName = "인덕원국빈관나이트";
const mapUrl = "https://map.naver.com/v5/search/인덕원%20국빈관나이트";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": "인덕원국빈관나이트 정보 안내",
      "url": "https://hh.nolcool.com/q/",
      "description": description,
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "contentUrl": "https://hh.nolcool.com/q/og-thumb.jpg",
        "width": 520,
        "height": 520
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "첫 이동 단계를 잡을 때 무엇부터 보면 좋나요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "밝은 도로와 안내 표지가 있는 지점을 먼저 살펴보고, 혼잡 구간을 피할 수 있는 흐름을 확인하는 것이 좋다."
          }
        },
        {
          "@type": "Question",
          "name": "야간 이동 중 불편함이 느껴지면 어떻게 해야 하나요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "조명이 밝고 사람이 지나가는 구간으로 이동해 잠시 정리한 뒤 다음 방향을 결정하는 편이 안전합니다."
          }
        },
        {
          "@type": "Question",
          "name": "현장에서 확인해야 할 예절은 무엇인가요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "통로를 막지 않고 보행 속도에 맞춰 이동하며, 촬영 가능 여부나 안내 지침을 먼저 확인하는 것이다."
          }
        },
        {
          "@type": "Question",
          "name": "카톡 문의는 어떤 방식이 효율적인가요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "필요한 항목을 짧게 정리해 전달하면 답을 빠르게 받기 쉽고, 불필요한 왕복을 줄일 수 있습니다."
          }
        },
        {
          "@type": "Question",
          "name": "이동 중 길을 헷갈렸을 때는 어떻게 하나요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "무리하게 이동을 이어가기보다 주변 표지를 확인해 방향을 다시 정하는 것이 좋다."
          }
        },
        {
          "@type": "Question",
          "name": "마무리 단계에서 확인하면 좋은 항목은 무엇인가요?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "소지품과 동행 여부, 혼잡 시간대 확인을 먼저 하고 이동 경로를 한 번 더 점검하면 안정적으로 마무리할 수 있습니다."
          }
        }
      ]
    }
  ]
};

const faqItems = [
  {q:"인덕원역에서 도보로 갈 수 있나요?",a:"4호선 인덕원역에서 도보 약 8분 거리다. 편의점을 지나 골목으로 꺾으면 된다."},
  {q:"카카오톡 문의가 가능한가요?",a:"카톡 ID 'besta12'로 운영 현황과 예약 문의가 가능합니다."},
  {q:"라운지형 분위기라는데, 시끄럽지 않나요?",a:"대화가 편안할 정도의 음량을 유지하는 조용한 분위기다."},
  {q:"금요일 밤 대기 시간이 긴가요?",a:"금요일 밤 10시 이후에는 대기할 수 있습니다. 첫 방문이면 평일 저녁을 추천한다."},
  {q:"현금만 받는 건가요?",a:"카드 결제가 되지만, 현금 소액 3만 원 정도를 준비하면 안심이다."},
  {q:"안양·의왕에서 접근이 쉬운가요?",a:"경기 남부 야간 이동의 거점으로, 인덕원역 4호선을 이용하면 편리합니다."},
  {q:"주차는 편한가요?",a:"인근 공영주차장 이용이 필요하며, 주말 밤에는 만차가 잦다. 대중교통이 낫다."},
  {q:"체류 시간은 보통 얼마인가요?",a:"평균 1시간 30분~2시간 정도이며, 편안한 분위기라 오래 머무는 편이다."}
];

const galleryImages = [
  {src:"/q/naver-thumb.webp",alt:"인덕원국빈관나이트 정문 전경"},
  {src:"/q/ChatGPT Image 2026년 2월 6일 오전 03_26_45.webp",alt:"인덕원국빈관나이트 내부 테이블 배치와 분위기"},
  {src:"/q/ChatGPT Image 2026년 2월 6일 오전 03_26_55.webp",alt:"인덕원국빈관나이트 라운지 조명과 좌석"}
];
---
<BaseLayout title={title} description={description} ogImage={ogImage} jsonLd={jsonLd}>
  <main id="main-content" class="detail-page detail-page--night">
    <section class="detail-hero" data-reveal>
      <figure class="detail-hero__figure">
        <img src={ogImage} alt={`${storeName} 나이트 안내 썸네일`} width="520" height="520" loading="eager" decoding="async" fetchpriority="high" />
      </figure>
      <h1 class="detail-hero__title">{storeName}</h1>
      <div class="detail-hero__ctas">
        <a href={mapUrl} class="btn btn--primary" target="_blank" rel="noopener noreferrer">지도에서 보기</a>
        <a href="/" class="btn btn--outline" target="_blank" rel="noopener noreferrer">목록으로</a>
      </div>
    </section>

    <IntroBlock
      hookHeadline="인덕원국빈관나이트 화요일 퇴근길, 안양 방면 약속이 갑자기 취소됐을 때"
      bullets={[
        "인덕원역 4호선 출구 방향 — 도보 8분 거리, 골목 진입 직전 편의점이 랜드마크",
        "카톡 문의(besta12)로 당일 운영 여부를 먼저 확인하면 헛걸음 줄어듦",
        "주차장은 인근 공영주차장 이용 — 주말 밤에는 만차가 잦으니 대중교통 권장"
      ]}
      declaration="모임이 무산되자 저녁이 텅 비었습니다. 집에 바로 가기엔 아깝고, 어딘가 들르고 싶은데 마땅한 곳이 떠오르지 않습니다."
      storyVisible={'<p>그때 검색창에 인덕원국빈관나이트를 쳤다면, 출발 전 이 안내부터 읽어 보세요. 신분증 필수이며 입장 시 확인 절차가 있다. 현금 소액 3만 원 정도면 카드 불가 상황에 대비할 수 있습니다.</p><p>어느 화요일 저녁의 기록: 퇴근 후 인덕원역에서 내려 편의점 옆 골목으로 꺾었다. 간판이 크지 않아 지나칠 뻔했는데, 지도 앱 안내가 정확했습니다. 입구에서 신분증을 보여주고 안으로 들어가니 조명이 낮고 음악이 잔잔했다. 자리를 안내받기까지 2분, 음료가 나오기까지 5분. 옆 테이블과 거리가 넉넉해서 대화가 편했습니다. 10시 전에 나왔더니 역까지 도보 7분, 막차 걱정 없이 귀가했다.</p>'}
      storyHidden={'<p>카톡 문의 시 질문을 한 번에 정리하지 않으면 답변이 느려집니다. 인원·날짜·시간 세 가지를 한 줄로 보내세요. 4호선 출구를 반대편으로 나가면 10분 이상 돌아가게 되므로 출구 번호를 미리 저장해 두세요.</p><p>금요일 밤 10시 이후 방문은 대기 확률이 높습니다. 첫 방문이라면 평일 저녁을 권합니다.</p>'}
      ctas={[
        {label:"지도에서 보기",href:mapUrl},
        {label:"FAQ 바로가기",href:"#faq-section"}
      ]}
    />

      <section id="intro-line" class="section">
        <h2>서론 — 첫 동선을 세우는 글</h2>
        <p>낯선 밤길은 속도보다 방향이 먼저다. 인덕원국빈관나이트를 처음 접했다면 출구와 큰길 방향을 먼저 정해 두는 것이 좋습니다. 밝은 지점과 표지판이 있는 구역을 참고점으로 삼으면 길이 조금 바뀌어도 방향이 흔들리지 않는다.</p>
        <p>지도를 오래 들여다보기보다 현장의 흐름을 잠깐 관찰해 보세요. 사람들의 움직임은 안전한 길을 가리키는 힌트가 되기도 합니다. 서두르기보다 하나씩 확인하는 태도가 오히려 시간을 아껴 줍니다.</p>
      </section>

      <section id="core-line" class="section">
        <h2>본론 — 이동의 결을 잡기</h2>
        <div class="cards">
          <article class="card">
            <h3>큰길을 먼저 잡기</h3>
            <p>인덕원국빈관나이트를 참고해 이동할 때는 큰길을 먼저 잡고, 그 안에서 작은 선택을 반복하는 방식이 안정적이다. 참고점에서 참고점으로 이동하면 길이 다소 바뀌어도 전체 방향은 흔들리지 않습니다.</p>
          </article>
          <article class="card">
            <h3>혼잡을 읽는 한 박자</h3>
            <p>사람이 모이는 지점은 조명과 동선이 맞닿는 곳에 생기기 쉽다. 흐름이 막히는 구간에서는 잠시 속도를 낮추고 가장자리를 따라 이동하세요. 한 박자 늦게 움직이는 편이 충돌을 줄여 준다.</p>
          </article>
          <article class="card">
            <h3>체감 포인트 점검</h3>
            <p>현장의 체감은 구역마다 다르게 느껴진다. 밝기, 소리, 움직임의 속도가 바뀌는 지점을 메모해 두면 이후 선택이 훨씬 쉬워집니다. 도착 직후 짧게 둘러본 뒤 체류 위치를 정하는 방식으로 부담을 줄여 보자.</p>
          </article>
        </div>
        <p class="note">인덕원국빈관나이트는 이동 감각을 정리하려는 분들이 참고하는 키워드이므로, 자신의 컨디션을 중심으로 움직이는 것이 중요하다. 무리하게 빠른 길을 찾기보다 안정적인 길을 선택하세요.</p>
      </section>

      <section id="fieldnote" class="section">
        <h2>체크 메모 — 짧게 남기기</h2>
        <ul class="checklist">
          <li>도착 전에 큰길 방향과 주요 표지를 한 번만 확인하기</li>
          <li>혼잡 구간은 가장자리로 통과하고 속도는 잠시 낮추기</li>
          <li>짧은 휴식 지점을 정해 이동 리듬 유지하기</li>
          <li>문의는 필요한 항목만 간단히 정리해 전달하기</li>
        </ul>
        <p class="note">작은 메모는 이동 중 판단을 단순하게 만들어 줍니다. 길이 복잡해 보일수록 참고를 줄이고, 반복되는 질문을 줄이는 편이 마음의 여유를 지키는 데 도움이 됩니다.</p>
      </section>

      <section id="closing-line" class="section">
        <h2>결론 — 다음 행동의 정리</h2>
        <p>인덕원국빈관나이트 정보를 참고하는 분이라면, 빠르게 움직이기보다 방향을 잘 잡는 것이 우선이다. 동선의 큰 윤곽과 작은 참고점을 함께 떠올리면 현장에서의 선택이 훨씬 가볍고 명확해진다.</p>
        <p>확인이 필요한 경우에는 카톡 문의(besta12)를 활용해 간단히 전달하세요. 현장 공지와 주변 안내를 먼저 참고하면 불필요한 이동이 줄어들고, 안정적인 마무리에 도움이 됩니다.</p>
      </section>

    <Gallery images={galleryImages} />

    <div class="mid-cta">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">지도에서 보기</a>
      <a href="/" target="_blank" rel="noopener noreferrer" class="btn btn--outline">다른 장소 둘러보기</a>
    </div>

    <FAQ items={faqItems} />

    <div class="detail-log">
      <h3 class="detail-log__title">업데이트 기록</h3>
      <div class="detail-log__entry"><strong>2026.02.20</strong> Astro 마이그레이션</div>
      <div class="detail-log__entry"><strong>2026.02.02</strong> 초기 페이지 작성</div>
    </div>

    <TrustBlock storeName={storeName} />

    <section class="related" id="bottom-cta">
      <h3 class="related__title">관련 장소 안내</h3>
      <div class="related__grid">
        <a href="/j/" class="related__link" target="_blank" rel="noopener noreferrer">수원찬스돔 · 수원</a>
        <a href="/l/" class="related__link" target="_blank" rel="noopener noreferrer">신림그랑프리 · 신림</a>
        <a href="/b/" class="related__link" target="_blank" rel="noopener noreferrer">상봉동한국관 · 상봉</a>
        <a href="/i/" class="related__link" target="_blank" rel="noopener noreferrer">인천아라비안 · 인천</a>
        <a href="/r/" class="related__link" target="_blank" rel="noopener noreferrer">울산챔피언 · 울산</a>
        <a href="/f/" class="related__link" target="_blank" rel="noopener noreferrer">홍대펀나이트 · 홍대</a>
        <a href="/t/" class="related__link" target="_blank" rel="noopener noreferrer">대전세븐 · 대전</a>
      </div>
      <div class="bottom-cta">
        <a href="/" target="_blank" rel="noopener noreferrer" class="btn btn--outline">← 전체 목록으로</a>
        <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">지도에서 보기</a>
      </div>
    </section>
  </main>
</BaseLayout>
